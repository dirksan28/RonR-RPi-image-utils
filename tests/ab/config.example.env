# Copy to config.env. All downloaded and generated test artifacts are stored
# below PREPARED_CACHE_DIR and can be reused by subsequent test runs.
BASE_IMAGE=""
BASE_IMAGE_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-06-19/2026-06-18-raspios-trixie-arm64-lite.img.xz"
BASE_IMAGE_SHA256="acff736ca7945e3b305f07cda4abdb870910e12634991da69783611756e381b3"

# An exact generic ARM64 Linux kernel .deb built with QEMU virt/virtio support.
# The package is installed into the Pi OS userspace while preparing the cache.
KERNEL_DEB=""
KERNEL_DEB_URL="https://snapshot.debian.org/archive/debian/20250717T024010Z/pool/main/l/linux/linux-image-6.12.38%2Bdeb13-arm64-unsigned_6.12.38-1_arm64.deb"
KERNEL_DEB_SHA256="37a1b3480c9547490e724c734aa7d6a2b535e31f28a40e14e6a8462d8e03ca32"
PREPARED_CACHE_DIR="${PWD}/tests/ab/cache"
BASE_IMAGE_ARCHIVE="${PREPARED_CACHE_DIR}/raspios-trixie-arm64-lite.img.xz"
BASE_IMAGE_RAW="${PREPARED_CACHE_DIR}/raspios-trixie-arm64-lite.img"
KERNEL_DEB="${PREPARED_CACHE_DIR}/linux-image-6.12.38+deb13-arm64-unsigned_6.12.38-1_arm64.deb"
PREPARED_IMAGE="${PREPARED_CACHE_DIR}/raspios-virt-prepared.img"
KERNEL_IMAGE="${PREPARED_CACHE_DIR}/Image"
INITRAMFS_IMAGE="${PREPARED_CACHE_DIR}/initrd.img"
PREPARED_EXTRA_GB=2

QEMU_MACHINE="virt"
QEMU_MEMORY_MB=2048
QEMU_CPUS=2
SSH_PORT=2222
SSH_WAIT_SECONDS=300
GUEST_USER="pi"
SSH_PRIVATE_KEY="${PREPARED_CACHE_DIR}/keys/raspios-ab"
SSH_PUBLIC_KEY="${SSH_PRIVATE_KEY}.pub"
GUEST_WORKDIR="/var/tmp/image-backup-ab"
GUEST_BACKUP_DIR="/mnt/backup"
GUEST_BACKUP_DEVICE="/dev/vdb"
BACKUP_DISK_SIZE_GB=8

# Additional QEMU arguments as a Bash array, for example:
# QEMU_EXTRA_ARGS=(-dtb /path/to/virt.dtb)
QEMU_EXTRA_ARGS=()

# The harness clones this repository into the ignored cache and checks out this
# immutable revision before every upstream A/B run.
UPSTREAM_REPOSITORY="https://github.com/seamusdemora/RonR-RPi-image-utils.git"
UPSTREAM_REPO_DIR="${PREPARED_CACHE_DIR}/upstream-repo"
UPSTREAM_REVISION="0ee5757f43eca29c581ccb6d7ee8818e6ed2cb98"

INITIAL_SIZE_MB=2048
ARTIFACT_DIR="${PWD}/tests/ab/artifacts"
