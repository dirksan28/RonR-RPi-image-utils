#!/bin/bash
# image-mount mounts a standard 'raw' image file so it can be read or written as a device.
#
# Synopsis:
#   Usage: image-mount imagefile mountpoint [W95|Linux]
#   W95 mounts the BOOT partition; Linux mounts the ROOT partition.
#   Linux is assumed when no partition is specified.

errexit()
{
  # Centralize errors so failed setup does not continue into mount operations.
  echo ""
  echo "$1"
  echo ""
  exit 1
}

usage()
{
  errexit "Usage: $0 imagefile mountpoint [W95|Linux]"
}

# Mounting image partitions and running fsck require root privileges.
if [ $(id -u) -ne 0 ]; then
  errexit "$0 must be run as root user"
fi
PGMNAME="$(basename $0)"
for PID in $(pidof -x -o %PPID "${PGMNAME}"); do
  if [ ${PID} -ne $$ ]; then
    errexit "${PGMNAME} is already running"
  fi
done
IMGFILE="$1"
MNT="$2"
PART="$3"
if [[ "${IMGFILE}" = "" || "${MNT}" = "" ]]; then
  usage
fi
if [ ! -f "${IMGFILE}" ]; then
  errexit "${IMGFILE} not found"
fi
if [ ! -d "${MNT}" ]; then
  errexit "${MNT} is not a directory"
fi
# Linux/root is the default; W95 selects the boot partition.
# W95 mounts boot/FAT partition 1; Linux mounts root partition 2.
if [ "${PART}" = "" ]; then
  PART="2"
else
  PART="$(tr [A-Z] [a-z] <<< "${PART}")"
  if [ "${PART}" = "w95" ];then
    PART="1"
  elif [ "${PART}" = "linux" ];then
    PART="2"
  else
    usage
  fi
fi
# Ask before attaching and mounting the image read-write.
echo ""
echo -n "Mount ${IMGFILE} on ${MNT} (y/n)? "
while read -r -n 1 -s answer; do
  if [[ "${answer}" = [yYnN] ]]; then
    echo "${answer}"
    if [[ "${answer}" = [yY] ]]; then
      break
    else
      errexit "Aborted"
    fi
  fi
done
echo ""
# Expose the image partitions as loop devices before checking the selected filesystem.
LOOP="$(losetup -f --show -P "${IMGFILE}")"
if [ $? -ne 0 ]; then
  errexit "Unable to create loop device"
fi
# The boot partition uses FAT; the root partition may use F2FS or ext4.
if [ "${PART}" = "1" ]; then
  dosfsck "${LOOP}p${PART}"
else
  FS_TYPE=$(blkid "${LOOP}p${PART}" | sed -n 's|^.*TYPE="\(\S\+\)".*|\1|p')
  if [ "${FS_TYPE}" = "f2fs" ]; then
    fsck.f2fs "${LOOP}p${PART}"
  else
    fsck.ext4 -f "${LOOP}p${PART}"
  fi
fi
if [ $? -ne 0 ]; then
  losetup -d "${LOOP}"
  errexit "Filesystem appears corrupted"
fi
# Leave the loop device attached so the mounted filesystem remains usable.
mount "${LOOP}p${PART}" ${MNT}
echo ""
echo "${IMGFILE} mounted on ${MNT}"
echo ""
echo "When done, run:"
echo "umount ${MNT}"
echo "losetup -d ${LOOP}"
echo ""
