#!/bin/bash
# image-check checks the integrity of a standard 'raw' image file.
#
# Synopsis:
#   Usage: image-check imagefile [W95|Linux]
#   W95 checks the BOOT partition; Linux checks the ROOT partition.
#   Linux is assumed when no partition is specified.

errexit()
{
  # Keep error output consistent and terminate without leaving further work to do.
  echo ""
  echo "$1"
  echo ""
  exit 1
}

usage()
{
  errexit "Usage: $0 [--non-interactive] imagefile [W95|Linux]"
}

# Filesystem checks access image partitions through loop devices and require root.
if [ $(id -u) -ne 0 ]; then
  errexit "$0 must be run as root user"
fi
PGMNAME="$(basename $0)"
for PID in $(pidof -x -o %PPID "${PGMNAME}"); do
  if [ ${PID} -ne $$ ]; then
    errexit "${PGMNAME} is already running"
  fi
done
# The non-interactive mode is used by automated callers such as the A/B test.
NON_INTERACTIVE=FALSE
if [ "${1}" = "--non-interactive" ]; then
  NON_INTERACTIVE=TRUE
  shift
fi
IMGFILE="$1"
PART="$2"
if [ "${IMGFILE}" = "" ]; then
  usage
fi
if [ ! -f "${IMGFILE}" ]; then
  errexit "${IMGFILE} not found"
fi
# Linux/root is the default; W95 selects the boot partition instead.
# W95 checks boot/FAT partition 1; Linux checks root partition 2.
if [ "${PART}" = "" ]; then
  PART="2"
else
  PART="$(tr [A-Z] [a-z] <<< "${PART}")"
  if [ "${PART}" = "w95" ];then
    PART="1"
  elif [ "${PART}" = "linux" ];then
    PART="2"
  else
    usage
  fi
fi
# Interactive runs ask for confirmation before touching the image.
if [ "${NON_INTERACTIVE}" = "FALSE" ]; then
  echo ""
  echo -n "Check ${IMGFILE} (y/n)? "
  while read -r -n 1 -s answer; do
    if [[ "${answer}" = [yYnN] ]]; then
      echo "${answer}"
      if [[ "${answer}" = [yY] ]]; then
        break
      else
        errexit "Aborted"
      fi
    fi
  done
  echo ""
fi
# Attach the image and expose its partition devices for fsck.
LOOP="$(losetup -f --show -P "${IMGFILE}")"
if [ $? -ne 0 ]; then
  errexit "Unable to create loop device"
fi
# Select the checker for the boot filesystem or the root filesystem type.
FS_TYPE=$(blkid "${LOOP}p${PART}" | sed -n 's|^.*TYPE="\(\S\+\)".*|\1|p')
if [ "${PART}" = "1" ]; then
  if [ "${NON_INTERACTIVE}" = "TRUE" ]; then
    dosfsck -n "${LOOP}p${PART}"
  else
    dosfsck "${LOOP}p${PART}"
  fi
else
  if [ "${FS_TYPE}" = "f2fs" ]; then
    fsck.f2fs "${LOOP}p${PART}"
  else
    if [ "${NON_INTERACTIVE}" = "TRUE" ]; then
      fsck.ext4 -f -n "${LOOP}p${PART}"
    else
      fsck.ext4 -f "${LOOP}p${PART}"
    fi
  fi
fi
if [ $? -ne 0 ]; then
  losetup -d "${LOOP}"
  errexit "Filesystem appears corrupted"
fi
# Print ext4 metadata when available; this is useful after a successful check.
if [ "${FS_TYPE}" = "ext4" ]; then
  echo ""
  INFO="$(tune2fs -l "${LOOP}p${PART}" 2>/dev/null)"
  echo "${INFO}"
fi
# The image is no longer needed through the loop device after the check completes.
losetup -d "${LOOP}"
echo ""
